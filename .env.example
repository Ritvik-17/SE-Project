OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=postgresql+psycopg://rera:rera@localhost:5432/rera?sslmode=require
CONFIDENCE_THRESHOLD=0.7
API_URL=http://localhost:8000
EMBEDDING_MODEL=text-embedding-3-small
RERANKER=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base
KB_QUERY_REWRITE=true

# Adaptive interviews (step 7)
INTERVIEW_MAX_TURNS=30
INTERVIEW_MAX_FOLLOW_UPS=2

# Human-in-the-loop approvers (step 16), JSON lists of catalog role ids
# SDLC_APPROVERS=["project_manager","architect_developer","infosec","compliance_legal"]
# WORKFLOW_APPROVERS=["project_manager","infosec","compliance_legal"]
# CHANGE_APPROVERS=["product_owner","project_manager"]
# READINESS_APPROVERS=["project_manager","operations","infosec","compliance_legal"]

# Step 17: platform security
# Encryption at rest, required. Generate with: python -m app.security.crypto
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_OLD_KEYS=          # previous keys after a rotation (then run: python -m app.security.crypto --reencrypt)
# MFA_REQUIRED=true
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=8
# COOKIE_SECURE=true                 # when served over HTTPS
# EXPOSE_API_DOCS=false              # in production
# MODEL_PINNING_REQUIRED=true        # in production, with a dated OPENAI_MODEL such as gpt-4.1-mini-2025-04-14
# Retention (days)
# RETENTION_PROJECT_AFTER_ARCHIVE_DAYS=365
# RETENTION_AUDIT_DAYS=2920
